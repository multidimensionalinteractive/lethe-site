# LETHE dashboard environment (/etc/lethe-dashboard.env)

# Existing
# LETHE_DASHBOARD_ACCESS=
# GITHUB_TOKEN=
# OPENAI_API_KEY=

# Field Notes comments — Cloudflare Turnstile
# Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile
# Allowed hostnames: youarestillinsideit.com, www.youarestillinsideit.com
LETHE_TURNSTILE_SITE_KEY=
LETHE_TURNSTILE_SECRET_KEY=

# Public site URL (confirmation + unsubscribe links)
LETHE_SITE_URL=https://youarestillinsideit.com

# Comment + newsletter notification recipients (comma-separated)
LETHE_COMMENT_NOTIFY_EMAILS=feldpost@youarestillinsideit.com,matthaydon@gmail.com

# Newsletter JSON storage (defaults shown — create /var/lib/lethe-dashboard/ on VPS)
# LETHE_NEWSLETTER_SUBSCRIBERS_FILE=/var/lib/lethe-dashboard/newsletter-subscribers.json
# LETHE_NEWSLETTER_ISSUES_FILE=/var/lib/lethe-dashboard/newsletter-issues.json
# LETHE_NEWSLETTER_RATE_FILE=/var/lib/lethe-dashboard/newsletter-rate.json

# Email option A: Resend (https://resend.com) — recommended for confirm + weekly sends
LETHE_RESEND_API_KEY=
LETHE_MAIL_FROM="YOU ARE STILL INSIDE IT <feldpost@youarestillinsideit.com>"

# Email option B: Hostinger / SMTP
# LETHE_SMTP_HOST=smtp.hostinger.com
# LETHE_SMTP_PORT=587
# LETHE_SMTP_SECURE=false
# LETHE_SMTP_USER=feldpost@youarestillinsideit.com
# LETHE_SMTP_PASS=
