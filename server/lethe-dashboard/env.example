# LETHE dashboard environment (/etc/lethe-dashboard.env)

# Existing
# LETHE_DASHBOARD_ACCESS=
# GITHUB_TOKEN=
# OPENAI_API_KEY=

# Field Notes comments — Cloudflare Turnstile
# Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile
# Allowed hostnames: youarestillinsideit.com, www.youarestillinsideit.com
LETHE_TURNSTILE_SITE_KEY=
LETHE_TURNSTILE_SECRET_KEY=

# Comment notification recipients (comma-separated)
LETHE_COMMENT_NOTIFY_EMAILS=feldpost@youarestillinsideit.com,matthaydon@gmail.com

# Email option A: Resend (https://resend.com)
LETHE_RESEND_API_KEY=
LETHE_MAIL_FROM=LETHE Field Notes <feldpost@youarestillinsideit.com>

# Email option B: Hostinger / SMTP
# LETHE_SMTP_HOST=smtp.hostinger.com
# LETHE_SMTP_PORT=587
# LETHE_SMTP_SECURE=false
# LETHE_SMTP_USER=feldpost@youarestillinsideit.com
# LETHE_SMTP_PASS=
